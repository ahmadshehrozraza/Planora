# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================================
# 1. Node.js & Next.js Framework
# ==========================================
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ==========================================
# 2. Python & AI Engine (FastAPI/ML Models)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
/ai-engine/venv/
/ai-engine/.venv/
# Ignore serialized ML models so repo doesn't get heavy
*.pkl
*.joblib
*.h5

# ==========================================
# 3. Security & Environment Variables (CRITICAL)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem

# ==========================================
# 4. User Uploads & Media
# ==========================================
public/uploads/

# ==========================================
# 5. Package Manager Conflicts (Enforce NPM)
# ==========================================
# We only want package-lock.json to be tracked
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# ==========================================
# 6. OS, Vercel & Debug Logs
# ==========================================
.DS_Store
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*