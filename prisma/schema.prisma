generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
//  ENUMS
// ==========================================

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum TaskType {
  FEATURE
  TASK
  BUG
  SPIKE
  DOCS
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  CLOSED
}

enum ColumnCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum Permission {
  WORKSPACE_UPDATE
  WORKSPACE_DELETE
  WORKSPACE_MANAGE_MEMBERS
  WORKSPACE_MANAGE_ROLES
  WORKSPACE_VIEW_ALL_PROJECTS
  WORKSPACE_VIEW_ANALYTICS
  WORKSPACE_EXPORT_DATA

  PROJECT_CREATE
  PROJECT_VIEW
  PROJECT_UPDATE
  PROJECT_DELETE
  PROJECT_MANAGE_MEMBERS
  PROJECT_MANAGE_ROLES
  PROJECT_VIEW_ANALYTICS

  SPRINT_CREATE
  SPRINT_UPDATE
  SPRINT_DELETE
  SPRINT_COMPLETE

  TASK_CREATE
  TASK_UPDATE_FULL
  TASK_UPDATE_STATUS
  TASK_ASSIGN
  TASK_DELETE

  EVENT_CREATE
  EVENT_UPDATE
  EVENT_DELETE

  RISK_VIEW
  RISK_CREATE
  RISK_UPDATE
  RISK_DELETE

  COMMENT_CREATE
  COMMENT_DELETE

  FILE_UPLOAD
  FILE_DELETE
}

// ==========================================
//  ROLES & PERMISSIONS
// ==========================================

model CustomRole {
  id                 String       @id @default(cuid())
  name               String
  
  permissions        Permission[] 

  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  isSystem           Boolean      @default(false)
  isWorkspaceDefault Boolean      @default(false)
  isProjectDefault   Boolean      @default(false)
  inviteCode         String?      @unique

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  workspaceMembers   WorkspaceMember[] @relation("WorkspaceRoleRelation")
  projectMembers     ProjectMember[]   @relation("ProjectRoleRelation")
}

// ==========================================
//  USER & AUTH MODELS
// ==========================================

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  password              String?
  isActive              Boolean?  @default(true)

  emailVerified         DateTime?
  image                 String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLogin             DateTime?

  accounts              Account[]
  workspaceMembers      WorkspaceMember[]
  projectMembers        ProjectMember[]
  activityLogs          ActivityLog[]
  
  assignedTasks         Task[]          @relation("TaskAssignee")
  createdTasks          Task[]          @relation("TaskAssignedBy")
  comments              Comment[]       @relation("UserComments")
  likedComments         Comment[]       @relation("CommentLikes")
  createdEvents         Event[]         @relation("EventCreator")
  attachments           Attachment[]    @relation("UserAttachments")

  receivedNotifications Notification[]  @relation("ReceivedNotifications")
  sentNotifications     Notification[]  @relation("SentNotifications")

  preferences           UserPreference?
  reportedRisks         Risk[]          @relation("ReportedRisks") 
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lastWorkspaceId String?  
  theme           String   @default("system")
  sidebarExpanded Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ==========================================
//  WORKSPACE & PROJECT MODELS
// ==========================================

model Workspace {
  id         String   @id @default(cuid())
  name       String
  imageUrl   String?  @db.Text
  inviteCode String   @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customRoles  CustomRole[]
  members      WorkspaceMember[]
  projects     Project[]
  tasks        Task[]
  events       Event[]
  activityLogs ActivityLog[]
  attachments  Attachment[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  
  roleId      String
  role        CustomRole @relation("WorkspaceRoleRelation", fields: [roleId], references: [id], onDelete: Cascade)

  userId      String
  workspaceId String

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String?       @db.Text
  imageUrl         String?       @db.Text
  githubRepoUrl    String?       @db.Text
  inviteCode       String        @unique

  status           ProjectStatus @default(PLANNED)
  currency         String        @default("PKR")
  budget           Float         @default(0)

  estimatedKloc    Float?      
  calculatedEffort Float?    
  calculatedCost   Float?    
  avgResourceCost  Float?
  fpaMetadata      Json?

  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?

  workspaceId      String

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customRoles      CustomRole[]
  members          ProjectMember[]
  sprints          Sprint[]        
  customColumns    CustomColumn[]
  tasks            Task[]
  events           Event[]
  activityLogs     ActivityLog[]
  attachments      Attachment[]
  risks            Risk[]
  tags             Tag[]
  folders          ProjectFolder[]
}

model ProjectMember {
  id        String     @id @default(cuid())
  
  roleId    String
  role      CustomRole @relation("ProjectRoleRelation", fields: [roleId], references: [id], onDelete: Cascade)

  userId    String
  projectId String

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// ==========================================
//  SPRINT MODEL 
// ==========================================

model Sprint {
  id             String       @id @default(cuid())
  name           String
  goal           String?      @db.Text 
  description    String?      @db.Text

  sprintNumber   Int
  capacityPoints Int?

  status         SprintStatus @default(PLANNED) 

  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?

  projectId      String

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]
  events         Event[]

  @@unique([projectId, sprintNumber])
}

// ==========================================
//  RISK REGISTER MODEL 
// ==========================================

model Risk {
  id           String     @id @default(cuid())
  title        String   
  probability  RiskLevel  @default(MEDIUM)
  impact       RiskLevel  @default(MEDIUM)
  mitigation   String?    @db.Text 
  status       RiskStatus @default(OPEN)

  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User       @relation("ReportedRisks", fields: [reportedById], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectId])
}

// ==========================================
//  CUSTOM COLUMN MODEL
// ==========================================

model CustomColumn {
  id        String         @id @default(cuid())
  name      String
  position  Int
  category  ColumnCategory @default(TODO)
  projectId String

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
}

// ==========================================
//  TAG MODEL
// ==========================================

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#e2e8f0")

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks     Task[]   @relation("TaskTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

// ==========================================
//  PROJECT FOLDER MODEL
// ==========================================

model ProjectFolder {
  id           String       @id @default(cuid())
  name         String
  isRestricted Boolean      @default(false)

  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  attachments  Attachment[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([projectId, name])
}

// ==========================================
//  TASK MODEL
// ==========================================

model Task {
  id           String       @id @default(cuid())
  name         String
  description  String?      @db.Text

  branchName   String? 

  columnId     String
  column       CustomColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  position     Int

  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sprintId     String? 
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: Cascade) 

  assigneeId   String?
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  assignedById String
  assignedBy   User         @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  taskType     TaskType     @default(TASK)
  priority     TaskPriority @default(MEDIUM)

  metadata     Json?   

  budget       Float        @default(0)
  currency     String       @default("PKR")
  effortPoints Int          @default(1)

  startDate    DateTime?
  dueDate      DateTime?

  blockedBy    Task[]       @relation("TaskDependencies")
  blocking     Task[]       @relation("TaskDependencies")

  tags         Tag[]        @relation("TaskTags")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  comments     Comment[]
  attachments  Attachment[]
}

// ==========================================
//  COMMENT MODEL
// ==========================================

model Comment {
  id        String    @id @default(cuid())
  text      String    @db.Text
  
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User      @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  likedBy   User[]    @relation("CommentLikes")
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ==========================================
//  EVENT MODEL
// ==========================================

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  
  date        DateTime   
  endDate     DateTime?  
  
  status      EventStatus @default(SCHEDULED)
  
  location    String?     @db.Text
  notes       String?     @db.Text 
  isOpened    Boolean     @default(false)

  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId   String?    
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId    String?  
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: Cascade) 

  creatorId   String
  creator     User        @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  attachments Attachment[]
}

// ==========================================
//  ACTIVITY / AUDIT LOG MODEL
// ==========================================

model ActivityLog {
  id          String    @id @default(cuid())

  workspaceId String
  projectId   String?  

  userId      String   

  action      String  

  entityType  String  
  entityId    String  

  metadata    Json?    
  
  createdAt   DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([userId])
}

// ==========================================
//  NOTIFICATIONS MODEL
// ==========================================

model Notification {
  id          String   @id @default(cuid())

  userId      String   
  user        User     @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  actorId     String   
  actor       User     @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  workspaceId String
  projectId   String?  
  entityId    String   
  entityType  String  
  action      String   
  title       String   
  message     String   
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isRead])
}

// ==========================================
//  ATTACHMENT / FILE MODEL
// ==========================================

model Attachment {
  id           String         @id @default(cuid())
  name         String  
  url          String         @db.Text 
  size         Int     
  type         String  

  uploadedById String
  uploadedBy   User           @relation("UserAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  folderId     String?
  folder       ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  taskId       String?
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  eventId      String?
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([folderId])
  @@index([taskId])
  @@index([eventId])
}